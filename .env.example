# altCMS Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Cookie security — set to 'true' when serving over HTTPS directly (not behind HTTP proxy)
COOKIE_SECURE=false

# Database
DATABASE_URL=postgresql://altcms:altcms@localhost:5432/altcms

# Session
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Admin (first run)
ADMIN_EMAIL=admin@altcms.local
ADMIN_PASSWORD=admin123

# Migration source (WordPress)
WP_DB_HOST=localhost
WP_DB_PORT=3306
WP_DB_NAME=wordpress
WP_DB_USER=root
WP_DB_PASS=
WP_API_URL=
WP_API_USER=
WP_API_PASS=

# Uploads
UPLOAD_DIR=./src/uploads
MAX_FILE_SIZE=10485760

# Store
STORE_ITEMS_PER_PAGE=20
CURRENCY=VND
