{
  "name": "altcms",
  "version": "1.0.0",
  "description": "Lightweight Agentic CMS — replaces WordPress + WooCommerce + Flatsome",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrations/run.js",
    "migrate:wipe": "node src/migrations/run.js --wipe",
    "build:css": "npx tailwindcss -i ./src/public/css/input.css -o ./src/public/css/app.css --minify",
    "watch:css": "npx tailwindcss -i ./src/public/css/input.css -o ./src/public/css/app.css --watch",
    "seed": "node src/seeds/run.js"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/formbody": "^8.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/session": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/view": "^10.0.0",
    "ejs": "^3.1.10",
    "pg": "^8.13.0",
    "bcryptjs": "^2.4.3",
    "nanoid": "^5.0.0",
    "sharp": "^0.33.0",
    "dotenv": "^16.4.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
