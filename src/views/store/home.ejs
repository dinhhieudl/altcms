<section class="bg-indigo-600 text-white">
  <div class="max-w-7xl mx-auto px-4 py-20 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Chào mừng đến <%= site.name %></h1>
    <p class="text-xl text-indigo-200 mb-8">Khám phá sản phẩm và bài viết mới nhất</p>
    <a href="/products" class="inline-block bg-white text-indigo-600 font-semibold px-8 py-3 rounded-lg hover:bg-indigo-50 transition">Mua sắm ngay</a>
  </div>
</section>

<% if (products && products.length) { %>
<section class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
  <h2 class="text-2xl font-bold mb-6">Sản phẩm mới</h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    <% products.forEach(p => { %>
    <a href="/products/<%= p.slug %>" class="group">
      <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden">
        <% if (p.featured_image) { %>
          <img src="<%= p.featured_image %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-105 transition">
        <% } else { %>
          <div class="w-full h-full flex items-center justify-center text-gray-400">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        <% } %>
      </div>
      <h3 class="mt-2 text-sm font-medium text-gray-900 group-hover:text-indigo-600"><%= p.name %></h3>
      <p class="text-sm text-gray-500"><%= p.price ? Number(p.price).toLocaleString('vi-VN') + '₫' : '' %></p>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (posts && posts.length) { %>
<section class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
  <h2 class="text-2xl font-bold mb-6">Bài viết mới</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <% posts.forEach(p => { %>
    <a href="/blog/<%= p.slug %>" class="group">
      <% if (p.featured_image) { %>
        <img src="<%= p.featured_image %>" alt="<%= p.title %>" class="w-full h-40 object-cover rounded-lg group-hover:opacity-90 transition">
      <% } %>
      <h3 class="mt-2 font-medium text-gray-900 group-hover:text-indigo-600"><%= p.title %></h3>
      <% if (p.excerpt) { %><p class="text-sm text-gray-500 line-clamp-2"><%= p.excerpt %></p><% } %>
    </a>
    <% }) %>
  </div>
</section>
<% } %>
