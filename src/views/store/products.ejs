<div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
  <h1 class="text-3xl font-bold mb-8">Sản phẩm</h1>

  <div class="flex flex-col lg:flex-row gap-8">
    <!-- Filters sidebar -->
    <aside class="lg:w-64 flex-shrink-0">
      <form method="GET" action="/products" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Tìm kiếm</label>
          <input type="text" name="q" value="<%= query?.q || '' %>" class="w-full px-3 py-2 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Sắp xếp</label>
          <select name="sort" class="w-full px-3 py-2 border rounded-lg text-sm">
            <option value="created_at" <%= query?.sort === 'created_at' ? 'selected' : '' %>>Mới nhất</option>
            <option value="price" <%= query?.sort === 'price' ? 'selected' : '' %>>Giá</option>
            <option value="name" <%= query?.sort === 'name' ? 'selected' : '' %>>Tên A-Z</option>
          </select>
        </div>
        <button type="submit" class="w-full bg-indigo-600 text-white py-2 rounded-lg text-sm hover:bg-indigo-700">Lọc</button>
      </form>
    </aside>

    <!-- Product grid -->
    <div class="flex-1">
      <% if (products && products.length) { %>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          <% products.forEach(p => { %>
          <a href="/products/<%= p.slug %>" class="group">
            <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden">
              <% if (p.featured_image) { %>
                <img src="<%= p.featured_image %>" alt="<%= p.name %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition">
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-gray-300">
                  <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
              <% } %>
            </div>
            <h3 class="mt-2 text-sm font-medium text-gray-900 group-hover:text-indigo-600 truncate"><%= p.name %></h3>
            <div class="flex items-center gap-2">
              <span class="text-sm font-semibold text-indigo-600"><%= Number(p.price).toLocaleString('vi-VN') %>₫</span>
              <% if (p.compare_at_price && p.compare_at_price > p.price) { %>
                <span class="text-xs text-gray-400 line-through"><%= Number(p.compare_at_price).toLocaleString('vi-VN') %>₫</span>
              <% } %>
            </div>
          </a>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (pagination.totalPages > 1) { %>
        <div class="flex justify-center gap-2 mt-8">
          <% if (pagination.hasPrev) { %><a href="?page=<%= pagination.page - 1 %>" class="px-3 py-2 border rounded-lg text-sm hover:bg-gray-100">← Trước</a><% } %>
          <span class="px-3 py-2 text-sm text-gray-500">Trang <%= pagination.page %>/<%= pagination.totalPages %></span>
          <% if (pagination.hasNext) { %><a href="?page=<%= pagination.page + 1 %>" class="px-3 py-2 border rounded-lg text-sm hover:bg-gray-100">Tiếp →</a><% } %>
        </div>
        <% } %>
      <% } else { %>
        <p class="text-gray-500 text-center py-12">Không tìm thấy sản phẩm nào.</p>
      <% } %>
    </div>
  </div>
</div>
