<article class="max-w-3xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
  <nav class="text-sm text-gray-500 mb-6">
    <a href="/" class="hover:text-gray-700">Trang chủ</a> /
    <a href="/blog" class="hover:text-gray-700">Blog</a> /
    <span class="text-gray-900"><%= post.title %></span>
  </nav>

  <% if (post.featured_image) { %>
    <img src="<%= post.featured_image %>" alt="<%= post.title %>" class="w-full h-64 md:h-96 object-cover rounded-xl mb-8">
  <% } %>

  <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"><%= post.title %></h1>

  <div class="flex items-center gap-4 text-sm text-gray-500 mb-8">
    <% if (post.author_name) { %><span>Bởi <%= post.author_name %></span><% } %>
    <% if (post.published_at) { %><span><%= new Date(post.published_at).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' }) %></span><% } %>
  </div>

  <div class="prose prose-lg max-w-none"><%- post.content || '' %></div>
</article>
