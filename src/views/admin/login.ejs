<div class="max-w-md mx-auto mt-20">
  <div class="bg-white rounded-xl shadow-sm p-8">
    <h1 class="text-2xl font-bold text-center mb-6">Đăng nhập Admin</h1>
    <form id="login-form" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input type="email" name="email" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu</label>
        <input type="password" name="password" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
      </div>
      <p id="error" class="text-sm text-red-600 hidden"></p>
      <button type="submit" class="w-full bg-indigo-600 text-white py-2.5 rounded-lg font-semibold hover:bg-indigo-700">Đăng nhập</button>
    </form>
  </div>
</div>
<script>
document.getElementById('login-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = new FormData(e.target);
  const res = await fetch('/api/auth/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: form.get('email'), password: form.get('password') }),
  });
  const data = await res.json();
  if (data.user) {
    window.location = '/admin';
  } else {
    const err = document.getElementById('error');
    err.textContent = data.error || 'Đăng nhập thất bại';
    err.classList.remove('hidden');
  }
});
</script>
