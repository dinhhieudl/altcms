<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="text-xl font-bold text-indigo-600"><%= site.name %></a>
      <nav class="hidden md:flex space-x-8">
        <a href="/products" class="text-gray-600 hover:text-gray-900">Sản phẩm</a>
        <a href="/blog" class="text-gray-600 hover:text-gray-900">Blog</a>
      </nav>
      <div class="flex items-center space-x-4">
        <form action="/search" method="GET" class="hidden sm:block">
          <input type="text" name="q" placeholder="Tìm kiếm..." class="w-48 lg:w-64 px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
        </form>
        <a href="/cart" class="relative text-gray-600 hover:text-gray-900">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
          <span id="cart-count" class="absolute -top-2 -right-2 bg-indigo-600 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center hidden">0</span>
        </a>
        <% if (user) { %>
          <a href="/admin" class="text-sm text-gray-600 hover:text-gray-900"><%= user.name %></a>
        <% } %>
      </div>
    </div>
  </div>
</header>
